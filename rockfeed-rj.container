# Quadlet: copie para ~/.config/containers/systemd/rockfeed-rj.container
# depois: systemctl --user daemon-reload && systemctl --user enable --now rockfeed-rj.service
#
# Ajuste o caminho do volume abaixo se o repositório não estiver em %h/rockfeed-rj.
[Unit]
Description=RockFeed RJ - feed RSS de shows de rock (container)
After=network-online.target

[Container]
Image=ghcr.io/wallacepnts/rockfeed-rj:latest
ContainerName=rockfeed-rj
PublishPort=8765:8765
Volume=%h/rockfeed-rj/app/data:/app/data:Z
AutoUpdate=registry

HealthCmd=CMD-SHELL python -c "import urllib.request; urllib.request.urlopen('http://localhost:8765/health', timeout=3)"
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
Notify=healthy

# tsdproxy discovery — expõe na tailnet como https://rockfeed.<sua-tailnet>.ts.net
Label=tsdproxy.enable=true
Label=tsdproxy.name=rockfeed
Label=tsdproxy.port.web=443/https:8765/http

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
